      "groundingSupports": [
        {
          "segment": {
            "endIndex": 184,
            "text": "The Swiss Ice Hockey Federation (SIHF) is the governing body for ice hockey in Switzerland, established in 1908 and a founding member of the International Ice Hockey Federation (IIHF)."
          },
          "groundingChunkIndices": [
            0
          ]
        },
        {
          "segment": {
            "startIndex": 185,
            "endIndex": 307,
            "text": "It serves as the umbrella organization for Swiss ice hockey, overseeing both amateur and professional levels of the sport."
          },
          "groundingChunkIndices": [
            1,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 309,
            "endIndex": 461,
            "text": "**Company Overview:**\nThe SIHF manages approximately 320 affiliated clubs, with around 1,000 referees, 11,400 active players, and 13,500 junior players."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 462,
            "endIndex": 540,
            "text": "These participants form 1,200 teams that play roughly 16,000 games per season."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 541,
            "endIndex": 626,
            "text": "The federation operates with about 400 honorary officials and 35 permanent employees."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 628,
            "endIndex": 870,
            "text": "**Business Model:**\nThe SIHF's core purpose is to develop and promote ice hockey throughout Switzerland, from grassroots to elite levels, by organizing and managing national game operations according to international and national regulations."
          },
          "groundingChunkIndices": [
            3
          ]
        },
        {
          "segment": {
            "startIndex": 871,
            "endIndex": 1035,
            "text": "It represents Swiss ice hockey interests both nationally and internationally and provides various services to its member clubs, including granting playing licenses."
          },
          "groundingChunkIndices": [
            3
          ]
        },
        {
          "segment": {
            "startIndex": 1036,
            "endIndex": 1274,
            "text": "The organization is structured in a matrix format, with key departments including Sport, Leagues & Cup, Education, Officiating, and Marketing/Sponsoring & Communications, supported by Finance, Human Resources, and Coordination & Services."
          },
          "groundingChunkIndices": [
            4,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 1275,
            "endIndex": 1455,
            "text": "The SIHF also engages in the financing of major sporting events, considering public acceptance and innovative marketing strategies, and focuses on value-oriented sports sponsoring."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 1457,
            "endIndex": 1775,
            "text": "**Key Products/Services:**\nThe federation's main offerings include the management of all national teams, comprehensive talent and youth development programs, and the organization of league championships and cup tournaments across all levels, from the Sky Swiss League down to the 4th League, as well as junior leagues."
          },
          "groundingChunkIndices": [
            4,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 1776,
            "endIndex": 1911,
            "text": "It also oversees the refereeing system (Officiating) and provides initial and continuing education for all aspects of Swiss ice hockey."
          },
          "groundingChunkIndices": [
            4,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 1912,
            "endIndex": 2046,
            "text": "Other services include awarding playing licenses, hosting events like the Swiss Ice Hockey Night and Awards, and operating a fan shop."
          },
          "groundingChunkIndices": [
            4,
            2,
            3
          ]
        },
        {
          "segment": {
            "startIndex": 2048,
            "endIndex": 2237,
            "text": "**Market Position:**\nAs the recognized governing body for ice hockey in Switzerland, the SIHF holds a dominant market position as the sport's primary regulatory and developmental authority."
          },
          "groundingChunkIndices": [
            0
          ]
        },
        {
          "segment": {
            "startIndex": 2238,
            "endIndex": 2290,
            "text": "It is the \"Dachorganisation\" (umbrella organization)"
          },
          "groundingChunkIndices": [
            1,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 2291,
            "endIndex": 2404,
            "text": "for the sport, managing both professional and amateur games, indicating a comprehensive reach across the country."
          },
          "groundingChunkIndices": [
            0
          ]
        },
        {
          "segment": {
            "startIndex": 2406,
            "endIndex": 2506,
            "text": "**Headquarters Location:**\nThe headquarters of the Swiss Ice Hockey Federation is located in Zurich."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 2507,
            "endIndex": 2598,
            "text": "Moneyhouse also lists its location in Glattbrugg, which is part of the greater Zurich area."
          },
          "groundingChunkIndices": [
            3
          ]
        },
        {
          "segment": {
            "startIndex": 2600,
            "endIndex": 2734,
            "text": "**Recent News:**\nRecent discussions involving the SIHF include the future of sports sponsoring, emphasizing a value-oriented approach."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 2735,
            "endIndex": 2933,
            "text": "Switzerland anticipates a \"golden sports decade\" with upcoming World and European Championships, Special Olympics, and potential Olympic and Paralympic Games, which the SIHF is actively involved in."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 2934,
            "endIndex": 3056,
            "text": "Christian Hofstetter from the SIHF has contributed expert opinions on the financing and challenges of large sports events."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 3057,
            "endIndex": 3169,
            "text": "The federation continues to host its annual Swiss Ice Hockey Night and Awards, with events planned through 2025."
          },
          "groundingChunkIndices": [
            4,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 3171,
            "endIndex": 3285,
            "text": "**Notable Achievements or Challenges:**\n*   **Achievements:**\n    *   Being a founding member of the IIHF in 1908."
          },
          "groundingChunkIndices": [
            0
          ]
        },
        {
          "segment": {
            "startIndex": 3290,
            "endIndex": 3375,
            "text": "*   Adopting the \"Foundation, Talent, Elite, Mastery\" program for player development."
          },
          "groundingChunkIndices": [
            0
          ]
        },
        {
          "segment": {
            "startIndex": 3380,
            "endIndex": 3473,
            "text": "*   Successfully managing and organizing a vast network of leagues, cups, and national teams."
          },
          "groundingChunkIndices": [
            4,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 3478,
            "endIndex": 3533,
            "text": "*   Developing a robust talent and youth sport program."
          },
          "groundingChunkIndices": [
            4,
            2
          ]
        },
        {
          "segment": {
            "startIndex": 3538,
            "endIndex": 3622,
            "text": "*   Maintaining a significant number of clubs, players, and games under its purview."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 3623,
            "endIndex": 3743,
            "text": "*   **Challenges:**\n    *   Addressing the complexities of financing large sports events and securing public acceptance."
          },
          "groundingChunkIndices": [
            1
          ]
        },
        {
          "segment": {
            "startIndex": 3748,
            "endIndex": 3884,
            "text": "*   Adapting to evolving trends in sports sponsoring to remain attractive to brands and secure funding for the sport's continued growth."
          },
          "groundingChunkIndices": [
            1
          ]
        }
      ],
